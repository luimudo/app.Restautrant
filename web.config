<?xml version="1.0" encoding="UTF-8"?>
<!-- Hosting IIS (SmarterASP): todas las peticiones las atiende Node (index.js) via iisnode.
     Express sirve el frontend compilado (server/public) y la API. El codigo fuente no se publica como archivo estatico. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="server" />
          <add segment="client" />
          <add segment="scripts" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <iisnode loggingEnabled="true" devErrorsEnabled="false" watchedFiles="web.config;index.js" />
  </system.webServer>
</configuration>
