<?xml version="1.0" encoding="UTF-8"?>
<!-- Hosting IIS (SmarterASP): IIS arranca Node con httpPlatformHandler (este servidor no tiene iisnode; con iisnode
     el sitio responde 503) y le reenvia todas las peticiones por el puerto %HTTP_PLATFORM_PORT%.
     Express sirve el frontend compilado (server/public) y la API. El codigo fuente no se publica como archivo estatico. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node" arguments="index.js" startupTimeLimit="60" startupRetryCount="2"
                  stdoutLogEnabled="true" stdoutLogFile=".\log.txt">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="server" />
          <add segment="client" />
          <add segment="scripts" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
